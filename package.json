{
  "name": "thegoodplace-builder",
  "version": "1.0.0",
  "description": "Pipeline di build per il database ESG dell'extension The Good Place",
  "type": "module",
  "private": true,
  "scripts": {
    "build-db": "node scripts/build-db.mjs",
    "build-db:bcorp": "node scripts/build-db.mjs --only=bcorp",
    "build-db:wikidata": "node scripts/build-db.mjs --only=wikidata",
    "build-db:curated": "node scripts/build-db.mjs --only=curated",
    "build-db:goodonyou": "node scripts/build-db.mjs --only=goodonyou",
    "build-db:ethicalconsumer": "node scripts/build-db.mjs --only=ethicalconsumer",
    "build-db:cdp": "node scripts/build-db.mjs --only=cdp"
  },
  "engines": {
    "node": ">=18"
  }
}
