{
  "manifest_version": 3,
  "name": "The Good Place - Ethical Finance Checker",
  "version": "1.0.0",
  "description": "Valuta brand e organizzazioni secondo parametri di finanza etica, mostrando un voto da 0 a 10.",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["data/brands.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
